{
  "routes": [
    { "route": "/api/auth/*",      "allowedRoles": ["anonymous"] },
    { "route": "/api/projects/*",  "allowedRoles": ["anonymous"] },
    { "route": "/api/controls/*",  "allowedRoles": ["anonymous"] },
    { "route": "/api/evidences/*", "allowedRoles": ["anonymous"] },
    { "route": "/api/users/*",     "allowedRoles": ["anonymous"] },
    { "route": "/api/logs",        "allowedRoles": ["anonymous"] },
    { "route": "/api/archive",     "allowedRoles": ["anonymous"] },
    { "route": "/*",               "rewrite": "/index.html" }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  }
}
